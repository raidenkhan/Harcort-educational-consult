# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw video/audio masters — working files, uploaded to the video platform and
# never served or committed. A multi-MB master in /public would be published at
# a public URL AND copied into every deploy; in git it would sit in history
# forever, since commits are additive. Keep masters here, reference the hosted
# player by id instead (see TESTIMONIAL in src/app/page.tsx).
/media/

# saved-page dumps (webpack chunks / saved design pages from a browser save tool)
sn-*.js
sn-*.css
supernova-home.html
