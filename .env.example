# Supabase project credentials — copy this file to .env.local and fill in values
# from: Supabase Dashboard → Project Settings → API.
#
# Only these two are needed. The browser never talks to Supabase (no anon key,
# no Supabase Auth) — every query runs server-side through the service role.
NEXT_PUBLIC_SUPABASE_URL=

# Server-only. NEVER expose this to the browser, and never rename it with a
# NEXT_PUBLIC_ prefix — that would inline it into the client bundle.
# Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Student "Contact admin" button — admin WhatsApp number in international
# format, digits only, no "+" (e.g. 233201234567). Leave empty to hide the CTA.
NEXT_PUBLIC_ADMIN_WHATSAPP=

# Google sign-in (OAuth 2.0 authorization code flow — server-side only).
# Create an OAuth client: Google Cloud Console → APIs & Services →
# Credentials → Create credentials → OAuth client ID → Web application.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# (plus your production origin). These are server-only — never NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email notifications (Resend — https://resend.com). Free tier: 3,000
# emails/month, 100/day, no credit card. Server-only. When RESEND_API_KEY is
# missing, every notification is a silent no-op (the app never breaks).
# Create a key: https://resend.com/api-keys
RESEND_API_KEY=

# From-address. Resend's default onboarding@resend.dev only delivers to the
# account owner's email — verify a domain and use e.g.
#   EMAIL_FROM="Harcourt Educational Consult <notifications@yourdomain.com>"
EMAIL_FROM=

# Public origin used in email links (chat, dashboard, admin). Defaults to
# http://localhost:3000 in dev.
APP_URL=

# ─── Analytics (optional) ──────────────────────────────────────────────────
# Extra salt for the first-party page-view visitor hash (0025). Any random
# string; changing it only splits unique-visitor counts across the change.
ANALYTICS_SALT=

# ─── Paystack (payments) ────────────────────────────────────────────────────
# Paystack GH merchant account: https://paystack.com/gh — Settings → API Keys
# & Webhooks. Server-only — never NEXT_PUBLIC_ the secret key.
PAYSTACK_SECRET_KEY=
# Public key — only needed if a client-side Paystack popup is ever added; the
# current flow uses Paystack's hosted checkout, which needs just the secret.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Webhook URL to register in the Paystack dashboard (Settings → API Keys &
# Webhooks): <APP_URL>/api/payments/webhook
# Events: charge.success, transfer.success, transfer.failed, transfer.reversed
# Checkout returns to: <APP_URL>/dashboard?payment=return

# Public key for the checkout popup, safe to expose to the browser.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Webhook URL to register in the Paystack dashboard (live + test):
#   https://<your-domain>/api/payments/webhook
# The route verifies Paystack's x-paystack-signature HMAC before trusting
# anything in the payload.

# Secret for the deadline-sweep cron route (/api/payments/sweep). Any long
# random string; Vercel Cron sends it as the Bearer token. Generate:
#   openssl rand -hex 32
CRON_SECRET=

# ─── Arkesel SMS ───────────────────────────────────────────────────────────
# Ghana-focused, pay-as-you-go SMS API: https://arkesel.com — Dashboard → API
# Keys. Server-only; when ARKESEL_API_KEY is missing every SMS is a silent
# no-op (same fail-safe pattern as email). See src/lib/sms.ts.
ARKESEL_API_KEY=a0NTVU9rQ0dSaFRXeUR6R1RES24

# Sender ID shown on the recipient's handset (max 11 chars, alphanumeric).
# Must be REGISTERED and APPROVED in Ghana before sends succeed — an
# unapproved ID fails every send with 403. Defaults to "Harcourt" when unset.
ARKESEL_SENDER_ID=

# Sandbox mode: "1" makes the API accept the request without billing it and
# without delivering it to the network — free end-to-end testing. Set "1"
# while building, "0" (or unset) for real texts.
ARKESEL_SANDBOX=1

# Cost guards. Texts are billed per message, so the app bounds itself:
#   ARKESEL_DAILY_CAP    — max texts the whole app may send per day
#   ARKESEL_PER_NUMBER_CAP — max texts to one number per day
#   ARKESEL_MIN_BALANCE — stop sending when the account drops below this
# Defaults: 200 / 10 / 50.
ARKESEL_DAILY_CAP=
ARKESEL_PER_NUMBER_CAP=
ARKESEL_MIN_BALANCE=

# Arkesel delivery reports: the app passes <APP_URL>/api/sms/delivery as the
# callback_url on every send, and Arkesel calls it back with
# ?sms_id=&status= (batched, ~10 minutes apart). No dashboard setting needed.

# ─── Session reminders (scheduler) ─────────────────────────────────────────
# The reminder route (/api/sessions/remind) is fired by
# .github/workflows/reminders.yml every 15 minutes, using the SAME
# CRON_SECRET as the Vercel cron above. Add CRON_SECRET as a repository
# secret too: Settings → Secrets and variables → Actions.
#
#   CRON_SECRET=<the same value you set for Vercel>
#
# Optional: override the site the workflow calls (defaults to the Vercel
# production URL).
#   APP_URL=https://your-domain
